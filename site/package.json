{
  "name": "befold-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "lint:fix": "oxlint --type-aware --fix --report-unused-disable-directives",
    "format": "oxfmt -c ../.oxfmtrc.json .",
    "format:check": "oxfmt -c ../.oxfmtrc.json --check .",
    "migrate:diff": "atlas migrate diff --env local",
    "migrate:lint": "atlas migrate lint --env local --latest 1",
    "migrate:hash": "atlas migrate hash --env local",
    "migrate:local": "wrangler d1 migrations apply befold-analytics --local",
    "migrate:remote": "wrangler d1 migrations apply befold-analytics --remote",
    "migrate:list": "wrangler d1 migrations list befold-analytics --remote",
    "migrate:list:staging": "wrangler d1 migrations list befold-analytics-staging --remote --env staging",
    "seed:local": "node tools/seed-local.mjs",
    "migrate:staging": "wrangler d1 migrations apply befold-analytics-staging --remote --env staging"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "markdown-it": "^15.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
