{
  // 配布サイト（Cloudflare Worker）の Oxlint 設定。方針は共通ベースにあり、
  // ここは検査対象の指定と、この面に固有の緩和だけを持つ。
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],

  "env": {
    "es2024": true,
    // Worker のランタイムは Web 標準 API（fetch / URL / crypto / caches …）を
    // 持つので browser を有効にする。Node ではないが、oxlint の env に
    // workers 相当が無いためこれで代替する。
    "browser": true
  },

  "ignorePatterns": [
    "node_modules/**",
    ".wrangler/**",
    // wrangler が生成する 538KB の型定義。手で書く場所ではない。
    "worker-configuration.d.ts"
  ],

  // --- 型情報を使う検査（TASK-505）---
  //
  // `npm run lint` は `--type-aware` 付きで走る。Worker では await し忘れた
  // D1 書き込みがリクエスト終了で黙って消えるが、この誤りは tsc でも型情報を
  // 使わない lint でも検出できない。それを捕まえるためだけに入れている。
  //
  // 有効化するのは下記 3 つに絞る。実測（2026-08-16、oxlint 1.78.0）で既定の
  // type-aware ルールセットは site/ に 567 件の指摘を出し、内訳は
  // `prefer-readonly-parameter-types` 250 / `no-deprecated` 160 /
  // `no-unsafe-*` 98 / その他 59 だった。これらを潰す作業は lint 導入とは
  // 別の判断なので、ここでは理由つきで落として導入自体を通す。
  "rules": {
    // await し忘れた Promise。このルールを入れるのが導入の目的で、
    // 実測では現状 0 件なので、クリーンなまま回帰だけを止めるゲートになる。
    "typescript/no-floating-promises": "error",
    // Promise を返す関数を void 期待の位置（イベントハンドラ、条件式）に
    // 渡す誤り。上と同じクラスの取りこぼしを別の形で捕まえる。
    "typescript/no-misused-promises": "error",
    // Promise でない値への await。無意味な await は「非同期のつもりで
    // 同期のまま」を示す手がかりになる。
    "typescript/await-thenable": "error",

    // --- 以下は理由つきで無効化する ---

    // 実測 250 件。引数を readonly にして回るのはコードベース全体の書き方を
    // 変える判断で、lint 導入に紛れ込ませない。
    "typescript/prefer-readonly-parameter-types": "off",
    // 実測 160 件、その大半が test/ の `env`（@cloudflare/vitest-pool-workers が
    // deprecated 扱いにしているが、代替は提供されていない）。自分たちのコードの
    // 誤りをほぼ指さないので入れない。
    "typescript/no-deprecated": "off",
    // 実測 98 件。外部 JSON（GitHub API・Access の JWKS）を any から絞り込む
    // 箇所に集中している。型ガードへ書き換える価値はあるが、それは独立した
    // タスクで決める。
    "typescript/no-unsafe-call": "off",
    "typescript/no-unsafe-member-access": "off",
    "typescript/no-unsafe-assignment": "off",
    "typescript/no-unsafe-argument": "off",
    "typescript/no-unsafe-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    // hono のルータは `return c.redirect(...)` / `return next()` の形が定型で、
    // 実測 13 件と 3 件はすべてこの書き方に対するもの。既存の慣習を否定する。
    "typescript/return-await": "off",
    "typescript/no-confusing-void-expression": "off",
    // 残りは件数が少ないが、いずれも既存コードの意図した書き方に当たる
    // （JSX 要素の文字列化、any を条件式に置く箇所、比較関数なしの sort）。
    "typescript/strict-boolean-expressions": "off",
    "typescript/no-base-to-string": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/prefer-nullish-coalescing": "off",
    "typescript/no-misused-spread": "off",
    "typescript/prefer-includes": "off"
  },

  "overrides": [
    {
      // TypeScript では未定義参照を tsc が捕まえる（npm run typecheck）。
      // oxlint の no-undef は型宣言を未定義と誤検知するため外す。
      // JSX は hono/jsx であって React ではないので、react 系プラグインは
      // そもそも有効にしていない（tsconfig.json の jsxImportSource を参照）。
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": { "eslint/no-undef": "off" }
    },
    {
      "files": ["test/**"],
      "plugins": ["vitest"],
      "env": { "vitest": true },
      "rules": {
        // Vitest の `expect(actual, message)` は第 2 引数にアサーションメッセージを
        // 取れる。既定の maxArgs=1 だと、どのケースで落ちたかを出すために付けて
        // いるメッセージが全部エラーになる（実測 20 件）。
        // ベース側にも同じ指定があるが、override で vitest プラグインを有効化すると
        // そちらのルール設定が引き継がれないため、ここにも書く。
        "vitest/valid-expect": ["error", { "maxArgs": 2 }],
        // テストは「この入力ならこう」を並べる場所で、テーブル駆動の for ループと
        // 逐次 await（D1 へ順に INSERT するなど）が既存の書き方。並列化すると
        // 挿入順が不定になり、順序を前提にしたアサートが壊れる。
        "eslint/no-await-in-loop": "off",
        "vitest/no-conditional-in-test": "off",
        // テスト内のヘルパはフィクスチャを閉じ込めるために意図して入れ子にする。
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      // ローカル D1 へサンプルを流し込む開発用スクリプト。Node で走る。
      "files": ["tools/**"],
      "plugins": ["node"],
      "env": { "node": true },
      "rules": { "eslint/no-await-in-loop": "off" }
    }
  ]
}
