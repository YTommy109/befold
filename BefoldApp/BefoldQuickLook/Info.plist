<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>befold QuickLook</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.quicklook.preview</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).PreviewViewController</string>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- アプリ本体 Info.plist の CFBundleDocumentTypes(LSItemContentTypes)の
			     和集合をそのまま写す。befold がどの UTI を扱うかはそちらが単一情報源で、
			     .mmd を net.ia.markdown が奪う件や .md の com.unknown.md といった
			     実環境の衝突も既に織り込まれている。public.svg-image だけは QuickLook
			     固有の追加(実機の .svg は public.xml ではなく public.svg-image に解決される)。
			     PDF・画像は macOS 標準の QuickLook に任せるため含めない。
			     QuickLookInfoPlistTests がこの対応をテストで担保する。 -->
			<key>QLSupportedContentTypes</key>
			<array>
				<string>com.degino.befold.mermaid-diagram</string>
				<string>net.ia.markdown</string>
				<string>net.daringfireball.markdown</string>
				<string>com.unknown.md</string>
				<string>com.degino.befold.source-code</string>
				<string>public.source-code</string>
				<string>public.swift-source</string>
				<string>public.python-script</string>
				<string>public.shell-script</string>
				<string>public.ruby-script</string>
				<string>public.perl-script</string>
				<string>public.php-script</string>
				<string>public.c-source</string>
				<string>public.c-plus-plus-source</string>
				<string>public.c-header</string>
				<string>public.objective-c-source</string>
				<string>com.sun.java-source</string>
				<string>com.netscape.javascript-source</string>
				<string>public.json</string>
				<string>public.yaml</string>
				<string>public.xml</string>
				<string>public.css</string>
				<string>public.comma-separated-values-text</string>
				<string>public.tab-separated-values-text</string>
				<string>public.html</string>
				<string>public.svg-image</string>
				<!-- .ts(TypeScript)は宣言しない。実機では public.mpeg-2-transport-stream
				     (動画)に解決されるが、この UTI を唯一宣言する拡張が befold だけの
				     状態にしても macOS は内蔵プレビューアを優先し、appex は呼ばれない
				     (2026-07-26 / macOS 26.5.2 で実機確認)。効かない宣言を残すと
				     本物の .ts 動画のプレビューを奪うリスクだけが残るため撤回した。 -->
			</array>
			<key>QLSupportsSearchableItems</key>
			<false/>
		</dict>
	</dict>
</dict>
</plist>
