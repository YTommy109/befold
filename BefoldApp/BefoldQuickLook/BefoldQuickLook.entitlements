<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- WKWebView はローカルコンテンツのみでも WebKit の Networking プロセスを起動する。
	     サンドボックス下でこれが無いと Networking プロセスが起動できず、
	     連鎖して WebContent も上がらないため、あらゆるロードが完了せず空白になる。
	     外部通信は viewer 側の replaceRemoteImages()(リモート画像を挿入前に代替表示へ
	     置き換える)と RemoteLoadBlocker の WKContentRuleList で塞ぐ。
	     **meta CSP の img-src はこの用途に使えない**: file:// で読み込んだ文書では
	     WebKit がリモート画像の取得を検査せず、素通りする(TASK-526 の実測)。 -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
