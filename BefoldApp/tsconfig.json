{
  // viewer-src の型検査だけを行う設定（TASK-432.4）。
  //
  // 出力は一切作らない（noEmit）。バンドルはこれまでどおり esbuild が担当し、
  // tsc は型検査専用。したがって成果物 viewer-bundle.js の作られ方は
  // TypeScript 導入の前後で変わらない。
  //
  // include はファイルの列挙ではなくディレクトリ全体にしてある。移行のたびに
  // 追記する列挙を作ると、追記漏れたモジュールが「型がついているように見えて
  // 実は無検査」という状態で静かに残る。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // viewer は WKWebView（Safari 17 相当）で動くので DOM を含める。
    // Node の型は入れない（viewer-src に Node 依存は無い）。
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    // esbuild が 1 ファイルずつ変換するため、型のみの import を残さない形に強制する。
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // viewer-src の .js は TASK-499 で全廃した。allowJs を外してあるのは、
    // 「.js を足すと解決対象には入るが型検査は受けない」という穴を復活させないため。
    // 新しいモジュールを .js で足すと tsc が解決できずその場で落ちる。
    "allowJs": false
  },
  "include": ["viewer-src/**/*"]
}
