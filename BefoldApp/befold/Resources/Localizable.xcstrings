{
  "sourceLanguage": "en",
  "strings": {
    "featureOverview.windowTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feature Overview"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機能説明"
          }
        }
      }
    },
    "featureOverview.formats.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported Formats"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応フォーマット"
          }
        }
      }
    },
    "featureOverview.formats.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renders Mermaid, Markdown, SVG, HTML, CSV/TSV, images, PDF, and source code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mermaid / Markdown / SVG / HTML / CSV・TSV / 画像 / PDF / ソースコードを表示できます。"
          }
        }
      }
    },
    "featureOverview.livePreview.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Preview"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルタイムプレビュー"
          }
        }
      }
    },
    "featureOverview.livePreview.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watches the open file and re-renders it automatically when it changes on disk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているファイルを監視し、変更されると自動的に再描画します。"
          }
        }
      }
    },
    "featureOverview.displayModes.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display Modes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示モード切替"
          }
        }
      }
    },
    "featureOverview.displayModes.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the same file between rendered preview, raw source, and git diff. The choice is remembered per file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じファイルをレンダリング表示・ソース表示・差分表示で切り替えられます。選んだモードはファイルごとに記憶されます。"
          }
        }
      }
    },
    "featureOverview.git.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git Integration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "git 連携"
          }
        }
      }
    },
    "featureOverview.git.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows change badges in the sidebar, overlays the git diff on the source view, and can narrow the sidebar to changed files only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーに変更状態を表示し、ソース表示に git 差分を重ねられます。サイドバーを変更のあったファイルだけに絞り込むこともできます。"
          }
        }
      }
    },
    "featureOverview.sidebar.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバー"
          }
        }
      }
    },
    "featureOverview.sidebar.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse the surrounding folder as a list or a tree, show or hide dotfiles, and move around with the keyboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じフォルダーの中身をリスト表示・ツリー表示で辿れます。不可視ファイルの表示切替やキーボードでの移動にも対応しています。"
          }
        }
      }
    },
    "featureOverview.search.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search & Quick Open"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索と Quick Open"
          }
        }
      }
    },
    "featureOverview.search.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find text in the document with case, whole-word, and regular-expression options, or fuzzy-search paths to open another file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書内の検索は大文字小文字・単語一致・正規表現を指定できます。パスのあいまい検索から別のファイルを開くこともできます。"
          }
        }
      }
    },
    "featureOverview.tabs.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs & Session Restore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブとセッション復元"
          }
        }
      }
    },
    "featureOverview.tabs.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open multiple files as tabs, move back and forward through the files you visited, bookmark the ones you return to, and pick up the last session's tabs on launch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数ファイルをタブとして開けます。辿ったファイルを戻る/進むで行き来でき、よく開くファイルはブックマークできます。前回のタブ構成は起動時に復元されます。"
          }
        }
      }
    },
    "featureOverview.integrations.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI & Quick Look"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI と Quick Look"
          }
        }
      }
    },
    "featureOverview.integrations.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open files from the terminal with the befold command, or preview them in Finder with the Quick Look extension."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "befold コマンドでターミナルからファイルを開けます。Finder のスペースキーによるプレビューにも対応しています。"
          }
        }
      }
    },
    "aiIntegration.windowTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Coding Agent Integration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI コーディングエージェント連携"
          }
        }
      }
    },
    "aiIntegration.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give an agent like Claude Code a skill file so that, just before it asks you to review a file it wrote, it opens that file with the `befold` CLI. You judge the rendered document instead of raw source, and it updates live as the agent revises the file. Save the following as e.g. ~/.claude/skills/befold-review/SKILL.md:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code などのエージェントに次の skill ファイルを与えると、エージェントが書いたファイルのレビューを依頼してくる直前に、そのファイルを befold CLI で開くようになります。raw のソースではなくレンダリング結果を見て判断でき、エージェントが修正するたびにプレビューも自動更新されます。例えば以下の内容を ~/.claude/skills/befold-review/SKILL.md として保存してください:"
          }
        }
      }
    },
    "aiIntegration.cliRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This needs the `befold` command line tool. Without it the agent silently skips opening the file. If you have not installed it yet, choose befold > Install Command Line Tool from the menu bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この連携には befold コマンドラインツールが必要です。未導入だとエージェントは何も言わずにファイルを開く処理を飛ばします。まだ入れていない場合は、メニューバーの befold > コマンドラインツールをインストール を実行してください。"
          }
        }
      }
    },
    "aiIntegration.loadFailed": {
      "extractionState": "manual",
      "localizations": {
