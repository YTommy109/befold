            "state": "translated",
            "value": "/usr/local/bin に 'befold' コマンドをインストールしました。"
          }
        }
      }
    },
    "cli.install.translocated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move befold.app to the Applications folder and reopen it, then try installing the 'befold' command again. The app is running from a temporary location, so the installed command would stop working."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "befold.app を アプリケーション フォルダーへ移動して開き直してから、もう一度 'befold' コマンドをインストールしてください。現在アプリは一時的な場所で実行されているため、インストールしてもコマンドは動かなくなります。"
          }
        }
      }
    },
