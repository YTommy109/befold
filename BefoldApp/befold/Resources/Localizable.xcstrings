{
  "sourceLanguage": "en",
  "strings": {
    "cli.folder.noFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No file found in this folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダーにファイルが見つかりません。"
          }
        }
      }
    },
    "cli.install.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to install the 'befold' command."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'befold' コマンドのインストールに失敗しました。"
          }
        }
      }
    },
    "cli.install.reinstallRecommended": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 'befold' command is outdated. Choose \"Install Command Line Tool\" from the menu to update it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'befold' コマンドが古い状態です。メニューの「コマンドラインツールをインストール」から更新してください。"
          }
        }
      }
    },
    "cli.install.success": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed the 'befold' command to /usr/local/bin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/usr/local/bin に 'befold' コマンドをインストールしました。"
          }
        }
      }
    },
    "cli.install.translocated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move befold.app to the Applications folder and reopen it, then try installing the 'befold' command again. The app is running from a temporary location, so the installed command would stop working."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "befold.app を アプリケーション フォルダーへ移動して開き直してから、もう一度 'befold' コマンドをインストールしてください。現在アプリは一時的な場所で実行されているため、インストールしてもコマンドは動かなくなります。"
          }
        }
      }
    },
