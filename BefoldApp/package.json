{
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "jest",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --fix --report-unused-disable-directives",
    "format": "oxfmt -c ../.oxfmtrc.json .",
    "format:check": "oxfmt -c ../.oxfmtrc.json --check .",
    "typecheck:viewer": "tsc --noEmit",
    "check:viewer-cycles": "node scripts/check-viewer-cycles.mjs",
    "build:viewer": "esbuild viewer-src/index.js --bundle --format=iife --target=safari17 --outfile=BefoldKit/Resources/viewer-bundle.js",
    "build:viewer-vendor": "node scripts/copy-viewer-vendor.mjs",
    "check:viewer-bundle": "npm run build:viewer && npm run build:viewer-vendor && git diff --exit-code -- BefoldKit/Resources/viewer-bundle.js BefoldKit/Resources/mermaid.min.js BefoldKit/Resources/github-markdown.css BefoldKit/Resources/github.css BefoldKit/Resources/github-dark.css",
    "check:third-party-licenses": "node scripts/check-third-party-licenses.mjs"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "babel-jest": "29.7.0",
    "dompurify": "3.4.12",
    "esbuild": "0.28.2",
    "github-markdown-css": "5.9.0",
    "highlight.js": "11.11.1",
    "jest": "^29.7.0",
    "jsdom": "^25.0.1",
    "markdown-it": "14.2.0",
    "mermaid": "11.15.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "5.9.3"
  }
}
