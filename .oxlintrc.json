{
  // リポジトリ共通の Oxlint 方針（TASK-498）。
  //
  // このファイルは **方針だけ**を持ち、検査対象の指定（ignorePatterns）は各
  // プロジェクト側の設定に置く。ignorePatterns を継承させると、パターンが
  // どのディレクトリ基準で解決されるかが設定ファイルの位置に依存して読みにくく
  // なるため。ここを継承するのは `site/.oxlintrc.json` と
  // `BefoldApp/.oxlintrc.json` の 2 つ。
  //
  // ルールを個別に無効化するときは **必ず理由を書く**。理由の無い無効化は、
  // 次にそのルールが必要になったときに「意図して外したのか、たまたま鳴って
  // 外したのか」が区別できなくなる。
  "$schema": "./site/node_modules/oxlint/configuration_schema.json",

  // 既定は correctness のみ。ここでは pedantic まで上げる。LLM が書いたコードは
  // 「動くが不用意」という形の誤りを持ち込みやすく、その多くは correctness では
  // なく suspicious / perf / pedantic に落ちるため。
  //
  // style と restriction は入れない。実測（2026-08-16、site/ 8,637 行）で
  // 全カテゴリを有効にすると 3,965 件、うち大半が `no-magic-numbers`(436) /
  // `one-var`(387) / `sort-keys`(332) / `no-async-await`(245) / `no-null`(154) /
  // `no-ternary`(46) といった「このコードベースが意図して選んでいる書き方」を
  // 否定するものだった。correctness〜pedantic なら 203 件で、内訳も実際の
  // 改善に対応する。
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },

  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],

  "rules": {
    // 未定義参照の検出。カテゴリには属さないため明示的に有効化する必要がある。
    // **.ts / .tsx では各プロジェクト側の override で off にする** —— 型宣言を
    // 未定義と誤検知するうえ、そちらの担保は tsc（npm run typecheck）にある。
    // 旧 ESLint 設定（BefoldApp/eslint.config.mjs）が持っていた唯一の検査で、
    // 移行にあたって落とさないためにここへ移した。
    "eslint/no-undef": "error",

    // 旧 ESLint 設定と同じオプションで引き継ぐ。引数の未使用は許す（シグネチャを
    // そろえるために置くことがある）、catch の束縛も許す、`_` 始まりは意図的な
    // 未使用として許す。
    "eslint/no-unused-vars": [
      "error",
      { "args": "none", "caughtErrors": "none", "varsIgnorePattern": "^_" }
    ],

    // Vitest / Jest の `expect(actual, message)` は第 2 引数にアサーション
    // メッセージを取れる。既定の maxArgs=1 だと、どのケースで落ちたかを
    // 出すために付けているメッセージが全部エラーになる（実測 20 件）。
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "jest/valid-expect": ["error", { "maxArgs": 2 }],

    // --- 以下は理由つきで無効化する ---

    // --- サイズ上限（TASK-684）---
    // 実測（2026-10-08、oxlint 1.78.0、既定閾値）は max-lines(300) が site 11 /
    // BefoldApp 17 ファイル、max-lines-per-function(50) が各 56 件。既定は
    // SwiftLint の file_length 400 / function_body_length 50 より厳しく、
    // テストの describe コールバックも関数として数えられるため、そのまま採ると
    // 指摘の大半が分割しようのない箇所になる。次のとおり決めた。
    //
    // max-lines: 400（SwiftLint file_length に揃える）。テストは 1000
    // （各面の override。describe 単位で読むため、本体の 2.5 倍まで許す）。
    "eslint/max-lines": ["error", 400],
    // max-lines-per-function: 150。50 だと本体だけで 35 件になり除外が本体になる。
    // 150 超は 3 関数（site landing.tsx 249 / BefoldApp find.ts 389・jump.ts 248）。
    // テストは describe が群全体を包むので各面の override で off。
    "eslint/max-lines-per-function": ["error", 150],
    // complexity: 既定の 20。超過は BefoldApp render.ts appendChunk の 1 件（30）。
    "eslint/complexity": ["error", 20],
    // max-depth: 既定の 4。超過は BefoldApp render.ts の 1 箇所（5）。
    "eslint/max-depth": ["error", 4],
    // import/max-dependencies は採らない。実測 site routes/public.tsx 15 /
    // BefoldApp render.ts 16・init.ts 12 の 3 件で、いずれも各モジュールを束ねる
    // 結線側。依存本数は行数と complexity の分割の副産物で、独立した上限に
    // する根拠が無い。
    "import/max-dependencies": "off",

    // 連鎖の途中で値を返し忘れると後続が undefined を受け取る、という誤りを
    // 捕まえるためのルール。連鎖の**最後**の then は戻り値を使わないのが普通なので
    // 除外する（除外しないと、終端で必ず意味の無い return を書くことになる）。
    "promise/always-return": ["error", { "ignoreLastCallback": true }]
  }
}
